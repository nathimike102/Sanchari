# ─── API Configuration ───────────────────────────────────────────────────────
# Set to your backend URL (default is localhost for development)
REACT_NATIVE_API_BASE_URL=http://localhost:5001/api/v1
REACT_NATIVE_API_TIMEOUT=30000

# ─── Debug Configuration ─────────────────────────────────────────────────────
DEBUG_API_CALLS=false
LOG_LEVEL=info

# ─── Firebase Configuration ──────────────────────────────────────────────────
# These are auto-loaded from google-services.json and GoogleService-Info.plist
# but can be overridden here if needed
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Google Sign-In Configuration ────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# ─── EAS / Expo Configuration ────────────────────────────────────────────────
EAS_PROJECT_ID=

# ─── Production Configuration ────────────────────────────────────────────────
# Uncomment and set for production deployment
# REACT_NATIVE_API_BASE_URL=https://api.sanchari.me/api/v1
# NODE_ENV=production
